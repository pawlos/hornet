<Project Sdk="Microsoft.NET.Sdk">
  <!--
    EXAMPLE harness: structure-aware fuzzing of System.IO.Compression's ZIP reader.
    System.IO.Compression lives in the shared framework, so (like the other BCL
    harnesses) it must be published self-contained or the runtime swaps the
    instrumented DLL for the framework copy at load time. instrument.sh handles the
    R2R strip; this csproj just asks for a self-contained publish.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>
</Project>
